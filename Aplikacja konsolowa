import java.util.Random;
import java.util.Scanner;

public class Main{

    static final int N = 50;

    public static void wypelnijTablice(int[] tab){
        Random random = new Random();

        for(int i = 0; i < N; i++){
            tab[i] = random.nextInt(100) + 1;
        }
    }

    public static int szukajZWartownikiem(int[] tab, int x){
        tab[N] = x;
        int i = 0;
        while(tab[i] != x){
            i++;
        }
        if(i == N){
            return -1;
        }

        return i;
    }

    public static void main(String[] args){
        Scanner scanner = new Scanner(System.in);
        int[] tab = new int[N + 1];
        wypelnijTablice(tab);
        System.out.print("Podaj liczbe do wyszukania (1-100): ");
        int x = scanner.nextInt();
        System.out.println("\nZawartosc tablicy:");

        for(int i = 0; i < N; i++){
            System.out.print(tab[i]);
            if(i < N - 1){
                System.out.print(", ");
            }
        }

        int wynik = szukajZWartownikiem(tab, x);
        if(wynik == -1){
            System.out.println("\n\nNie znaleziono liczby "
                    + x + " w tablicy.");
        }else{
            System.out.println("\n\nLiczba " + x
                    + " znajduje sie pod indeksem: " + wynik);
        }
        scanner.close();
    }
}
